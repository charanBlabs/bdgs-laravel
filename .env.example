APP_NAME="BD Growth Suite"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bdgs_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Local: Mailtrap — https://mailtrap.io → Sending Domains / SMTP → API token
MAIL_MAILER=smtp
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="noreply@bdgrowthsuite.com"
MAIL_FROM_NAME="BD Growth Suite"
MAIL_LOGO_URL=https://ik.imagekit.io/h1pfsvzlsf/bdgrowthsuite/images/logo.png

# Production (cPanel):
# MAIL_HOST=mail.bdgrowthsuite.com
# MAIL_PORT=465
# MAIL_USERNAME=noreply@bdgrowthsuite.com
# MAIL_PASSWORD=
# MAIL_SCHEME=smtps

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVIEWS_SYNC_TOKEN=
INQUIRY_AGENT_TOKEN=

# Cal.com Discovery Call (30-min element-click embed)
CAL_ORIGIN=https://app.cal.com
CAL_LINK=charan-tej-vattikuti-unbo7v/30min
