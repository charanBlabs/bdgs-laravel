# Staging environment — copy to .env on staging.bdgrowthsuite.com
# cp .env.staging.example .env && php artisan key:generate

APP_NAME="BD Growth Suite (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://staging.bdgrowthsuite.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Use a separate database from production.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=username_bdgs_staging
DB_USERNAME=username_bdgs_staging
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Optional: use log driver to avoid sending real mail from staging
# MAIL_MAILER=log
MAIL_MAILER=smtp
MAIL_HOST=mail.bdgrowthsuite.com
MAIL_PORT=465
MAIL_USERNAME=noreply@bdgrowthsuite.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="staging-noreply@bdgrowthsuite.com"
MAIL_FROM_NAME="BD Growth Suite Staging"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Use different tokens than production.
REVIEWS_SYNC_TOKEN=staging-reviews-sync-change-me
INQUIRY_AGENT_TOKEN=staging-inquiry-agent-change-me

ADMIN_EMAIL=admin@bdgrowthsuite.com
ADMIN_PASSWORD=StagingChangeMe123!
